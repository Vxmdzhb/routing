{
    "name": "astrx/routing",
    "description": "Parses and generates locale-aware URLs, with or without URL rewriting.",
    "license": "LicenseRef-DoWhatever",
    "type": "library",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered"
    ],
    "homepage": "https://github.com/Vxmdzhb/routing",
    "require": {
        "php": ">=8.4",
        "ext-session": "*",
        "astrx/config": "self.version",
        "astrx/http": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "AstrX\\Routing\\": ""
        }
    },
    "extra": {
        "astrx": {
            "resources": "resources"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/result"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/support"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/config"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/http"
        }
    ]
}
